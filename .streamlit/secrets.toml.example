# Copy to .streamlit/secrets.toml locally; paste hosted settings in Community Cloud.
# Authorization Code with PKCE does not require a client secret.
[spotify]
client_id = "your-spotify-client-id"
# Register the exact Home URL in the Spotify Developer Dashboard.
# Use https://your-app.streamlit.app/ when hosted. localhost is not accepted.
redirect_uri = "http://127.0.0.1:8501/"
